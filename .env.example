# Required
DATABASE_URL="postgresql://YOUR_MAC_USER@127.0.0.1:5432/yogurt_ops?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# First setup only: the admin account created by Setup Yogurt Database.command.
# After the first login, change the password with Change Password.command and delete ADMIN_PASSWORD.
ADMIN_EMAIL="owner@yogurt.local"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional: full /api/health details through the public URL (send it as the x-health-token header).
# HEALTH_TOKEN="at-least-16-random-characters"

# Optional: health monitor
# PUBLIC_BASE_URL="https://your-public-domain.example"
# HEALTH_ALERT_AFTER="2"

# Optional: alerts on your phone (see DATABASE_SETUP.md)
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# ALERT_WEBHOOK_URL=""

# Optional: copy every backup to a folder outside this Mac, encrypted with the passphrase
# BACKUP_OFFSITE_DIR="/Users/YOUR_MAC_USER/Library/Mobile Documents/com~apple~CloudDocs/YogurtBackups"
# BACKUP_PASSPHRASE="a long passphrase you also keep in a password manager"
