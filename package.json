{
  "name": "yogurt-super-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "db:setup": "prisma generate && prisma migrate deploy && node --env-file=.env scripts/seed-if-empty.mjs && node --env-file=.env scripts/ensure-admin-password.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "prisma validate && prisma generate && eslint . && tsc --noEmit && node --test tests/*.test.mjs && next build",
    "auth:set-admin": "node --env-file=.env scripts/set-admin-password.mjs",
    "test:e2e": "node --env-file=.env tests/authenticated-smoke.mjs",
    "db:backup": "./scripts/backup-and-verify.sh",
    "db:backup:dump": "./scripts/backup-db.sh",
    "db:verify-backup": "./scripts/verify-backup-restore.sh",
    "health:check": "./scripts/health-check.sh",
    "server": "./scripts/server-control.sh",
    "metrics:summary": "node scripts/web-vitals-summary.mjs",
    "test:e2e:business": "E2E_ADDITIONAL_SCRIPT=tests/readiness-workflow-e2e.mjs ./scripts/run-business-e2e.sh",
    "test:e2e:offline": "node --env-file=.env tests/offline-fallback-e2e.mjs",
    "metrics:vitals": "node scripts/web-vitals-summary.mjs",
    "alerts:test": "ALERT_COOLDOWN_SECONDS=0 ./scripts/send-alert.sh warning alert.test \"YoguManage alert test\"",
    "db:dr-drill": "E2E_ADDITIONAL_SCRIPT=tests/readiness-workflow-e2e.mjs ./scripts/disaster-recovery-drill.sh",
    "desktop:start": "node node_modules/electron/install.js && electron .",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:verify": "node scripts/verify-desktop.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-table": "^8.20.5",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.10.0",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.28",
    "playwright": "1.64.1",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.0"
  },
  "main": "desktop/main.cjs"
}
